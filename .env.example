# SmartLearn — Supabase Cloud Environment Variables
# SIH 2026 Theme: Smart Education | Team: HACKSMITH

# Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key (Safe for client-side usage protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# IMPORTANT: NEVER put the SUPABASE_SERVICE_ROLE_KEY in frontend code!
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-backend-only
